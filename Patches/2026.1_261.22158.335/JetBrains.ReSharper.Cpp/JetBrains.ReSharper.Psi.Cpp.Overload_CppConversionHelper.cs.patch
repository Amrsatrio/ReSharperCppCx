+	// @MOD C++/CX: called only after IsBoxable has accepted the source value.
+	// Boxing directly produces Object or the matching IBox<T>/Box<T>; it does
+	// not first produce a fictitious handle to the value class.
+	internal bool IsCppCxDirectBoxingTarget(CppQualType from, CppQualType to)
+	{
+		if (TypeFactory.GetDialect().LanguageKind != CppLanguageKind.CppCx)
+		{
+			return false;
+		}
+		CppQualType pointeeType = to.GetCliHandlePointeeType();
+		ICppClassResolveEntity objectClass = GetGlobalNamespace().GetBuiltinsRefs().GetManagedObject(CppLanguageKind.CppCx);
+		if (objectClass != null && CppTypesUtil.AreEqualUnqualifiedTypes(pointeeType, new CppQualType(objectClass)))
+		{
+			return true;
+		}
+		ICppClassResolveEntity box = pointeeType.GetResolvedClassTypeEntity();
+		if (box == null || box.GetLookupParent() != GetGlobalNamespace().GetBuiltinsRefs().cx_platform_ns)
+		{
+			return false;
+		}
+		CppSubstitutionId name = box.Name.AsSubstitutionId();
+		return name != null && (new CppQualifiedId("IBox").Equals(name.Inner) || new CppQualifiedId("Box").Equals(name.Inner))
+			&& name.Arguments.Length == 1 && name.Arguments[0] is ICppTypeTemplateArgument argument
+			&& CppQualTypeEq.ResolvedEquals(from.ClearCVQuals(), argument.GetQualType());
+	}
