+		private sealed class NativeTypeCache : IAssemblyDataCache
+		{
+			private readonly ClrNameInternTrie myNames = new ClrNameInternTrie();
+			private readonly DataIntern<ReflectionType> myTypes = new DataIntern<ReflectionType>();
+			private readonly DataIntern<string> myStrings = new DataIntern<string>();
+			private DataIntern<int[]> myAttributeHashes = new DataIntern<int[]>(new ArrayUtil.ArrayEqualityComparer<int>());
