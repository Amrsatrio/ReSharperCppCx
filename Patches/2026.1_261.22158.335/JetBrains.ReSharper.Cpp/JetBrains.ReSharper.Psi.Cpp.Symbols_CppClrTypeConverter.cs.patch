+	// Resolve MethodImpls against native declarations, including accessor
+	// methods whose CLR owner/property cannot be resolved.
+	internal bool TryGetCppCxOverrideTargets(ITypeMember member, ICppDeclaratorResolveEntity declarator, out List<ICppResolveEntity> targets)
+	{
+		targets = null;
+		if (myNativeTypes == null || member is not ICompiledElement)
+		{
+			return false;
+		}
+		List<ICppResolveEntity> result = new();
+		CppQualType signature = CppMethodInheritanceInfo.ComputeSignatureType(declarator.FindGroupedFunction());
+		foreach (var implementation in myNativeTypes.DecodeMethodImplementations(member))
+		{
+			ICppClassResolveEntity owner = ConvertBaseType(implementation.Type).GetResolvedClassTypeEntity();
+			if (owner == null)
+			{
+				continue;
+			}
+			if (member is IAccessor)
+			{
+				foreach (ICppResolveEntity child in owner.GetChildren())
+				{
+					if (child is ICppCxxCliPropertyDeclaratorResolveEntity property)
+					{
+						foreach (ICppResolveEntity accessor in property.GetChildren())
+						{
+							AddCppCxOverrideTargets(accessor, implementation.Name, signature, result);
+						}
+					}
+				}
+			}
+			else if (implementation.Name == "Dispose" && owner.Name.ClassNameAllowsDestructors())
+			{
+				AddCppCxOverrideTargets(owner.GetDestructors(), implementation.Name, signature, result);
+			}
+			else if (implementation.Name == "Finalize" && owner.Name.ClassNameAllowsDestructors())
+			{
+				AddCppCxOverrideTargets(owner.GetCliFinalizers(), implementation.Name, signature, result);
+			}
+			else
+			{
+				foreach (ICppResolveEntity child in owner.ChildByName(new CppQualifiedId(implementation.Name), CppLocationAnchor.BottomMost()))
+				{
+					AddCppCxOverrideTargets(child, implementation.Name, signature, result);
+				}
+			}
+		}
+		targets = result;
+		return true;
+	}
+
+	private static void AddCppCxOverrideTargets(ICppResolveEntity candidate, string metadataName, CppQualType signature, List<ICppResolveEntity> result)
+	{
+		if (candidate is not ICppFunctionDeclaratorResolveEntityPack pack)
+		{
+			return;
+		}
+		foreach (ICppGroupedFunctionDeclaratorResolveEntity function in pack.GetGroupedFunctions())
+		{
+			if (function.FindClrElement()?.ClrDeclaredElement is ITypeMember member && member.ShortName == metadataName
+				&& CppTypesUtil.EqualsIgnoringFunctionReturnTypeAndMagicTypes(signature, CppMethodInheritanceInfo.ComputeSignatureType(function))
+				&& !result.Contains(function))
+			{
+				result.Add(function);
+			}
+		}
+	}
