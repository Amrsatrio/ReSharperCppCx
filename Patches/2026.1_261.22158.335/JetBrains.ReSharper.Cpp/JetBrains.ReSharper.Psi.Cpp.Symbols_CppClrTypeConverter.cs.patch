+		// Preserve BYREF separately from [In]/[Out] parameter flags.
+		private readonly struct SignatureType
+		{
+			internal readonly ReflectionType Type;
+			internal readonly bool IsByRef;
+			internal readonly bool IsOut;
+			internal readonly bool HasConstPointerPointee;
+
+			internal SignatureType(IMetadataType type, ReflectionTypeBuilder builder, bool isOut = false)
+			{
+				Type = builder.UnwrapFromReferenceTypeAndCreate(type, out IsByRef);
+				IsOut = isOut;
+				HasConstPointerPointee = IsConstPointerPointee(type);
+			}
+		}
+
+		private static bool IsConstPointerPointee(IMetadataType type)
+		{
+			if (type is not IMetadataPointerType pointer)
+				return false;
+			foreach (IMetadataTypeModifier modifier in pointer.Type.TypeModifiers)
+			{
+				if (modifier.Type.FullName == "Platform.Runtime.CompilerServices.IsConst")
+					return true;
+			}
+			return false;
+		}
+
+		private readonly Dictionary<uint, SignatureType[]> mySignatures = new Dictionary<uint, SignatureType[]>();
+		private HashSet<uint> myFinalMethods;
+		// MethodImpl owners must follow the same native projection as bases.
+		private readonly Dictionary<uint, (ReflectionType Type, string Name)[]> myMethodImplementations = new();
+		private ReflectionType[] myBases;
+		private List<ITypeMember> myAdditionalMembers;
+
+		internal static CppCxMetadataTypes Load(ITypeElement element)
+		{
+			if (element is not CompiledTypeElement compiled || compiled.PsiAssemblyFile is not AssemblyPsiFile file
+				|| element.Module is not IAssemblyPsiModule module)
+			{
+				return null;
+			}
+			IAssemblyLocation location = module.Assembly.Location;
+			VirtualFileSystemPath path = location?.AssemblyPhysicalPath;
+			if (path.IsNullOrEmpty() || !path.Name.EndsWith(".winmd", StringComparison.OrdinalIgnoreCase)
+				|| file.MetadataLoaderFactory == null)
+			{
+				return null;
+			}
+			using MetadataLoader loader = file.MetadataLoaderFactory(location, module);
+			IMetadataAssembly assembly = loader.TryLoadFrom(location, JetFunc<AssemblyNameInfo>.True, loadElementTypes: false);
+			if (assembly == null)
+			{
+				return null;
+			}
+			IMetadataTypeInfo info = assembly.GetTypeInfoFromToken(new MetadataToken(compiled.Token));
+			NativeTypeCache cache = new NativeTypeCache();
+			ReflectionTypeBuilder builder = new ReflectionTypeBuilder(cache);
+			CppCxMetadataTypes result = new CppCxMetadataTypes();
+			HashSet<uint> visibleMembers = null;
+			if (info.IsWindowsRuntime)
+			{
+				visibleMembers = new HashSet<uint>();
+				foreach (ITypeMember member in element.GetMembers())
+				{
+					if (member is ICompiledElement declared)
+					{
+						visibleMembers.Add(declared.Token);
+					}
+				}
+			}
+			bool recoverMembers = false;
+			int baseCount = info.Base == null ? 0 : 1;
+			result.myBases = new ReflectionType[baseCount + info.InterfaceImplementations.Length];
+			if (info.Base != null)
+			{
+				result.myBases[0] = builder.Create(info.Base);
+			}
+			for (int i = 0; i < info.InterfaceImplementations.Length; i++)
+			{
+				result.myBases[baseCount + i] = builder.Create(info.InterfaceImplementations[i].Interface);
+			}
+			foreach (IMetadataMethod method in info.GetMethods())
+			{
+				// PSI normalizes final newslot methods to non-virtual members; retain their native final bit for CX
+				// override eligibility.
+				if (method.IsFinal)
+				{
+					(result.myFinalMethods ??= new HashSet<uint>()).Add(method.Token.Value);
+				}
+				IList<MethodSpecification> implementations = method.ImplementedMethods;
+				if (implementations.Count != 0)
+				{
+					var targets = new (ReflectionType Type, string Name)[implementations.Count];
+					for (int i = 0; i < targets.Length; i++)
+					{
+						targets[i] = (builder.Create(implementations[i].OwnerType), implementations[i].Method.Name);
+					}
+					result.myMethodImplementations[method.Token.Value] = targets;
+				}
+				IMetadataParameter[] parameters = method.Parameters;
+				SignatureType[] signature = new SignatureType[parameters.Length + 1];
+				signature[0] = new SignatureType(method.Signature.ReturnType, builder);
+				for (int i = 0; i < parameters.Length; i++)
+				{
+					signature[i + 1] = new SignatureType(parameters[i].Type, builder, parameters[i].IsOut);
+				}
+				result.mySignatures[method.Token.Value] = signature;
+			}
+			foreach (IMetadataField field in info.GetFields())
+			{
+				result.mySignatures[field.Token.Value] = new[] { new SignatureType(field.Type, builder) };
+			}
+			foreach (IMetadataProperty property in info.GetProperties())
+			{
+				IMetadataParameter[] indices = property.Getter?.Parameters;
+				int count = indices?.Length ?? Math.Max(0, (property.Setter?.Parameters.Length ?? 1) - 1);
+				indices ??= property.Setter?.Parameters;
+				SignatureType[] signature = new SignatureType[count + 1];
+				signature[0] = new SignatureType(property.Type, builder);
+				for (int i = 0; i < count; i++)
+				{
+					signature[i + 1] = new SignatureType(indices[i].Type, builder, indices[i].IsOut);
+				}
+				result.mySignatures[property.Token.Value] = signature;
+			}
+			foreach (IMetadataEvent @event in info.GetEvents())
+			{
+				result.mySignatures[@event.Token.Value] = new[] { new SignatureType(@event.Type, builder) };
+			}
+			if (visibleMembers != null)
+			{
+				foreach (IMetadataMethod method in info.GetMethods())
+				{
+					if (method.Name is not ".ctor" and not ".cctor" && !visibleMembers.Contains(method.Token.Value))
+					{
+						recoverMembers = true;
+						break;
+					}
+				}
+			}
+			if (recoverMembers)
+			{
+				// CLR projection removes implemented collection methods and their properties.
+				// Keep the original PSI declarations; supplement only the missing native tokens.
+				ReflectionElementPropertiesProvider provider = new ReflectionElementPropertiesProvider();
+				using ReflectionBuilder nativeBuilder = new ReflectionBuilder(cache, builder,
+					new ReflectionElementAccessibility(false), provider, true, cache.OnAssemblyLoadingFinished);
+				CompiledTypeElement nativeClass = ReflectionElementPropertiesProvider.GetTypeElementFactory(compiled, nativeBuilder).Create(compiled.Parent, nativeBuilder, info);
+				((ICacheTrieNodeOwner)nativeClass).TrieNode = ((ICacheTrieNodeOwner)compiled).TrieNode;
+				foreach (ITypeMember member in nativeClass.GetMembers())
+				{
+					if (member is ICompiledElement declared && !visibleMembers.Contains(declared.Token))
+					{
+						(result.myAdditionalMembers ??= new List<ITypeMember>()).Add(member);
+					}
+				}
+			}
+			else
+			{
+				cache.OnAssemblyLoadingFinished();
+			}
+			return result;
+		}
+
+		internal IEnumerable<ITypeMember> GetMembers(IEnumerable<ITypeMember> original)
+		{
+			return myAdditionalMembers == null ? original : original.Concat(myAdditionalMembers);
+		}
+
+		internal bool IsFinalMethod(ITypeMember member)
+		{
+			return member is ICompiledElement compiled && myFinalMethods?.Contains(compiled.Token) == true;
+		}
+
+		internal IEnumerable<(IDeclaredType Type, string Name)> DecodeMethodImplementations(ITypeMember member)
+		{
+			if (member is ICompiledElement compiled && myMethodImplementations.TryGetValue(compiled.Token, out var targets))
+			{
+				foreach (var target in targets)
+				{
+					if (DecodeType(target.Type, member) is IDeclaredType type)
+					{
+						yield return (type, target.Name);
+					}
+				}
+			}
+		}
+
+		internal IType Decode(ITypeMember member, int parameter)
+		{
+			if (member is not ICompiledElement compiled
+				|| !mySignatures.TryGetValue(compiled.Token, out SignatureType[] signature)
+				|| parameter + 1 >= signature.Length || signature[parameter + 1].Type is not ReflectionType type)
+			{
+				return null;
+			}
+			return DecodeType(type, member);
+		}
+
+		// An [Out] array without BYREF is a fill-array, not an output handle.
+		internal (bool IsByRef, bool IsOut)? GetParameterFlags(ITypeMember member, int parameter)
+		{
+			if (member is ICompiledElement compiled
+				&& mySignatures.TryGetValue(compiled.Token, out SignatureType[] signature)
+				&& parameter + 1 < signature.Length)
+			{
+				SignatureType type = signature[parameter + 1];
+				return (type.IsByRef, type.IsOut);
+			}
+			return null;
+		}
+
+		internal bool HasConstPointerPointee(ITypeMember member, int parameter)
+		{
+			return member is ICompiledElement compiled && mySignatures.TryGetValue(compiled.Token, out SignatureType[] signature) && parameter + 1 < signature.Length && signature[parameter + 1].HasConstPointerPointee;
+		}
+
+		internal IEnumerable<IDeclaredType> DecodeBases(ITypeElement owner)
+		{
+			foreach (ReflectionType type in myBases)
+			{
+				if (type != null && DecodeType(type, (ITypeMember)owner) is IDeclaredType declaredType)
+				{
+					yield return declaredType;
+				}
+			}
+		}
+
+		private static IType DecodeType(ReflectionType type, ITypeMember member)
+		{
+			TypeAnnotationsEnumerator<bool> dynamic = TypeAnnotationsEnumerator<bool>.Empty;
+			TypeAnnotationsEnumerator<string> tuple = TypeAnnotationsEnumerator<string>.Empty;
+			TypeAnnotationsEnumerator<NullableAnnotation> nullable = TypeAnnotationsEnumerator<NullableAnnotation>.Empty;
+			TypeAnnotationsEnumerator<bool> native = TypeAnnotationsEnumerator<bool>.Empty;
+			return type.DecodeType(member.Module.GetPsiServices(), member, member.Module, ref dynamic, ref tuple, ref nullable, ref native);
+		}
+	}
+
+	private IType GetNativeSignatureType(ITypeMember member, int parameter = -1)
+	{
+		return myNativeTypes?.Decode(member, parameter);
+	}
+
+	internal bool IsCppCxFinalMethod(ITypeMember member)
+	{
+		return myNativeTypes?.IsFinalMethod(member) == true;
+	}
