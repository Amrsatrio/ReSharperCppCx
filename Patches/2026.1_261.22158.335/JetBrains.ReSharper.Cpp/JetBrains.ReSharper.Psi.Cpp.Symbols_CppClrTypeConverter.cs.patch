+	// Use the same projection table as the WinMD reader, in the native direction.
+	private static class CppCxProjection
+	{
+		internal static readonly Dictionary<IClrTypeName, IClrTypeName> NativeNames = CreateNativeNames();
+
+		private static Dictionary<IClrTypeName, IClrTypeName> CreateNativeNames()
+		{
+			Dictionary<IClrTypeName, IClrTypeName> result = new Dictionary<IClrTypeName, IClrTypeName>();
+			foreach (var projection in WinMDProjectedTypes.WinMDToClr)
+			{
+				// WindowsNumerics projects the ABI names to platform.winmd's native value types, not to the CLR
+				// System.Numerics definitions.
+				string numericsName = GetNumericsName(projection.Key.Second);
+				IClrTypeName nativeName = new ClrTypeName(numericsName ?? projection.Key.Second);
+				result[new ClrTypeName(projection.Value.Second)] = nativeName;
+				// Native signatures must not resolve back through their CLR projections.
+				result[nativeName] = nativeName;
+				if (numericsName != null)
+				{
+					result[new ClrTypeName(projection.Key.Second)] = nativeName;
+				}
+			}
+			// The CLR projection table keeps Guid unchanged, while C++/CX exposes Platform::Guid.
+			IClrTypeName guidName = new ClrTypeName("Platform.Guid");
+			result[new ClrTypeName("System.Guid")] = guidName;
+			result[guidName] = guidName;
+			// The ABI's IReference<T> and the CLR's Nullable<T> both name Platform::IBox<T> in native signatures.
+			IClrTypeName boxName = new ClrTypeName("Platform.IBox`1");
+			result[new ClrTypeName("Windows.Foundation.IReference`1")] = boxName;
+			result[new ClrTypeName("System.Nullable`1")] = boxName;
+			result[boxName] = boxName;
+			return result;
+		}
+
+		// WindowsNumerics.impl.h's seven explicit native/WinRT ABI pairs.
+		internal static string GetNumericsName(string name)
+		{
+			return name switch
+			{
+				"Windows.Foundation.Numerics.Vector2" or "Windows.Foundation.Numerics.float2" => "Windows.Foundation.Numerics.float2",
+				"Windows.Foundation.Numerics.Vector3" or "Windows.Foundation.Numerics.float3" => "Windows.Foundation.Numerics.float3",
+				"Windows.Foundation.Numerics.Vector4" or "Windows.Foundation.Numerics.float4" => "Windows.Foundation.Numerics.float4",
+				"Windows.Foundation.Numerics.Matrix3x2" or "Windows.Foundation.Numerics.float3x2" => "Windows.Foundation.Numerics.float3x2",
