+	// @MOD C++/CX: source PSI nodes must follow the entities rebuilt at the final definition.
+	internal void RefreshCxPartialMemberMappings(CppClassData definition)
+	{
+		if (!myPsiModeEnabled || !definition.HasCxPartialDeclarations())
+		{
+			return;
+		}
+		List<ICppParserSymbol> symbols = null;
+		foreach (ICppSymbol symbol in mySymbolToEntityCache.Keys)
+		{
+			if (!(symbol is ICppParserSymbol parserSymbol))
+			{
+				continue;
+			}
+			for (ICppParserSymbol parent = parserSymbol.Parent; parent != null; parent = parent.Parent)
+			{
+				if (parent is CppClassSymbol { IsCxPartial: true } partial && definition.ContainsSymbol(partial))
+				{
+					(symbols ??= new List<ICppParserSymbol>()).Add(parserSymbol);
+					break;
+				}
+			}
+		}
+		if (symbols == null)
+		{
+			return;
+		}
+		var matches = myResolveCache.RootCache.SymbolLocator.FindResolveEntities(symbols);
+		CppJournal journal = myResolveCache.RootCache.GetCurrentJournal();
+		List<KeyValuePair<ICppSymbol, ICppResolveEntity>> previous = null;
+		foreach (ICppParserSymbol symbol in symbols)
+		{
+			foreach (ICppResolveEntity match in matches[symbol])
+			{
+				ICppResolveEntity replacement = GetCxPartialUngroupedMember(match, symbol);
+				if (replacement == null || ReferenceEquals(replacement, mySymbolToEntityCache[symbol]))
+				{
+					continue;
+				}
+				if (journal != null)
+				{
+					(previous ??= new List<KeyValuePair<ICppSymbol, ICppResolveEntity>>()).Add(
+						new KeyValuePair<ICppSymbol, ICppResolveEntity>(symbol, mySymbolToEntityCache[symbol]));
+				}
+				mySymbolToEntityCache[symbol] = replacement;
+				break;
+			}
+		}
+		if (previous != null)
+		{
+			journal.Add(new CxPartialMappingsChanged(this, previous));
+		}
+	}
+
+	// @MOD C++/CX: PSI caches store individual declarations, not overload groups.
+	private static ICppResolveEntity GetCxPartialUngroupedMember(ICppResolveEntity entity, ICppParserSymbol symbol)
+	{
+		switch (entity)
+		{
+			case Resolve.ICppGroupedFunctionDeclaratorResolveEntity functions:
+				foreach (var declaration in functions.GetUngroupedDeclarators())
+				{
+					if (System.Linq.Enumerable.Contains(declaration.SymbolParts, symbol))
+					{
+						return declaration;
+					}
+				}
+				break;
+			case Resolve.ICppGroupedVariableDeclaratorResolveEntity variables:
+				foreach (var declaration in variables.GetUngroupedDeclarators())
+				{
+					if (System.Linq.Enumerable.Contains(declaration.SymbolParts, symbol))
+					{
+						return declaration;
+					}
+				}
+				break;
+			case Resolve.ICppGroupedTypeDeclaratorResolveEntity types:
+				foreach (var declaration in types.GetUngroupedDeclarators())
+				{
+					if (System.Linq.Enumerable.Contains(declaration.SymbolParts, symbol))
+					{
+						return declaration;
+					}
+				}
+				break;
+			default:
+				return entity;
+		}
+		return null;
+	}
