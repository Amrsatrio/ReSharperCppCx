+	// @MOD C++/CX
+	private static bool IsCxLambdaConstructor(ICppGroupedFunctionDeclaratorResolveEntity candidate)
+	{
+		ICppResolveEntity declaration = candidate.RemoveSubstitution();
+		if (declaration is ICppGroupedFunctionDeclaratorResolveEntity grouped)
+		{
+			declaration = grouped.GetFirstUngrouped();
+		}
+		return declaration is CppCxxCliDelegateConstructorResolveEntity { ConstructorType: CppCxxCliDelegateConstructorResolveEntity.CtorType.CX_LAMBDA };
+	}
+
+	// @MOD C++/CX
+	private CppImplicitConversionSequence BuildCxDelegateLambdaConversion(ICppResolvedExpression argument, CppQualType parameterType)
+	{
+		CppExpressionInfo argumentInfo = CppExpressionInfo.FromExpression(argument, TypeContext.Factory);
+		if (TypeContext.Factory.GetDialect().LanguageKind == CppLanguageKind.CppCx &&
+			argumentInfo.Type.ClearRefs().GetResolvedClassTypeEntity() is CppLambdaClassResolveEntityBase lambda)
+		{
+			CppQualType signature = parameterType.GetReferencedType();
+			CppQualType[] parameters = signature.GetFunctionParameterTypes();
+			ICppExpression[] callArguments = new ICppExpression[parameters.Length];
+			for (int i = 0; i < parameters.Length; i++)
+			{
+				callArguments[i] = CppTemporaryExpression.CreateFromType(new CppTypeAndCategory(parameters[i].ClearRefs(), CppValueCategory.L_VALUE));
+			}
+			// vccorlib's capture invokes its copied functor with named (lvalue) parameters.
+			CppExpressionInfo callable = CppExpressionInfo.CreateTemporary(new CppTypeAndCategory(argumentInfo.Type.ClearRefs().ClearCVQuals(), CppValueCategory.L_VALUE));
+			CppOverloadingCandidate call = BuildMemberFunctionCandidate(lambda.GetGroupedParenOperatorOrTemplate(), callable, callArguments, callArguments.Length + 1, isOperatorCall: true, skipTemplatesByArgsCount: false, CppOperatorRewriteKind.None);
+			if (call.Viable && call is CppOrdinaryOverloadingCandidate ordinaryCall)
+			{
+				CppQualType returnType = ordinaryCall.InstantiateBodyAndGetFunction(in TypeContext.ViewPos).GetCppType(TypeContext.Factory).GetResolvedFunctionReturnType();
+				CppQualType targetReturnType = signature.GetResolvedFunctionReturnType();
+				if (targetReturnType.IsVoid() ? returnType.IsVoid() :
+					!returnType.IsVoid() && !IsBadOrAmbiguousImplicitConversion(CreateCppConversionHelper().FromCopyInitialization(CppTemporaryExpression.CreateFromType(returnType.GetTypeAndCategoryForCallReturnType()), targetReturnType)))
+				{
+					return CppStandardConversionSequence.CreateIdentityConversionSequence(argumentInfo.Type, argument, isDirectInitialization: false);
+				}
+			}
+		}
+		return new CppBadConversionSequence(CppBadConversionSequence.FailureStatus.GeneralFailure, ReferenceFlag.Empty, argumentInfo.Type, parameterType, argument);
+	}
+
