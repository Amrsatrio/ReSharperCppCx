+	private static bool IsFromPlatformWinmd(IClrDeclaredElement element) // @MOD C++/CX
+	{
+		if (element is not ITypeElement typeElement)
+			return false;
+		if (typeElement.Module is not Psi.Modules.IAssemblyPsiModule assemblyModule)
+			return false;
+		JetBrains.Util.VirtualFileSystemPath path = assemblyModule.Assembly.Location?.AssemblyPhysicalPath;
+		return !JetBrains.Util.FileSystemPathEx.IsNullOrEmpty(path) && string.Equals(path.Name, "platform.winmd", System.StringComparison.OrdinalIgnoreCase);
+	}
+
+	// @MOD C++/CX: WinRT ABI interfaces are usable by native consumers even when
+	// their metadata visibility is internal. Keep the existing PSI declaration.
+	private static bool IsExclusiveWinrtInterface(IClrDeclaredElement element)
+	{
+		if (element is not IInterface || element is not Impl.Reflection2.CompiledTypeElement { PsiAssemblyFile: Impl.Reflection2.WinMD.WinMDPsiFile })
+		{
+			return false;
+		}
+		foreach (IAttributeInstance attribute in ((IInterface)element).GetAttributeInstances(AttributesSource.Self))
+		{
+			if (attribute.GetClrName().FullName == "Windows.Foundation.Metadata.ExclusiveToAttribute")
+			{
+				return true;
+			}
+		}
+		return false;
+	}
