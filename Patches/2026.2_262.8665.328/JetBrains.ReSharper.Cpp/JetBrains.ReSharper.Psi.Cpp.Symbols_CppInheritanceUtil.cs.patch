+	// @MOD C++/CX: completion enumerates both runtime-class methods and their
+	// interfaces. A sealed implementation must not reappear via its interface slot.
+	public static bool IsCppCxSealedOverrideCandidate(ICppGroupedFunctionDeclaratorResolveEntity candidate, ICppClassResolveEntity derived)
+	{
+		if (derived.GetTypeFactory().GetDialect().LanguageKind != Language.CppLanguageKind.CppCx)
+		{
+			return false;
+		}
+		if (candidate.PureVirtualSpecifiers.IsSealed())
+		{
+			return true;
+		}
+		CppVTableEntryInfoPrimary slot = CppMethodInheritanceInfo.GetCached(candidate)?.PrimaryVirtualSlot;
+		CppClassInheritanceInfo inheritance = CppClassInheritanceInfo.GetCached(derived);
+		return slot != null && inheritance != null && inheritance.VTable.TryGetValue(slot.Slot, out CppVTableEntryInfo implementation)
+			&& (implementation.IsSealed || implementation.Method.IsSealed);
+	}
+
