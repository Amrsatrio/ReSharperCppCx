+	// @MOD C++/CX: called only after IsBoxable has accepted the source value.
+	// Preserve CLI boxing and CX boxing to Object; reuse the existing boxing
+	// conversion kind so non-boxing overloads keep their preferred ranking.
+	private bool IsCppCxBoxingTarget(CppQualType from, CppQualType to)
+	{
+		if (TypeFactory.GetDialect().LanguageKind != CppLanguageKind.CppCx)
+		{
+			return false;
+		}
+		ICppClassResolveEntity box = to.GetCliHandlePointeeType().GetResolvedClassTypeEntity();
+		if (box == null || box.GetLookupParent() != GetGlobalNamespace().GetBuiltinsRefs().cx_platform_ns)
+		{
+			return false;
+		}
+		CppSubstitutionId name = box.Name.AsSubstitutionId();
+		return name != null && (new CppQualifiedId("IBox").Equals(name.Inner) || new CppQualifiedId("Box").Equals(name.Inner))
+			&& name.Arguments.Length == 1 && name.Arguments[0] is ICppTypeTemplateArgument argument
+			&& CppQualTypeEq.ResolvedEquals(from.ClearCVQuals(), argument.GetQualType());
+	}
+
