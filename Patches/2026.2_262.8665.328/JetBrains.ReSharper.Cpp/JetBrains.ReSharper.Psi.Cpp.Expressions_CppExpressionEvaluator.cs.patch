+	// @MOD C++/CX
+	private static TriBool IsValidWinRtType(CppQualType type)
+	{
+		if (type.GetDependentInfo().IsTypeOrValueDependentOrContainsDependencyKiller())
+		{
+			return TriBool.Indeterminate;
+		}
+		if (type.IsRef || type.IsConst || type.IsVolatile)
+		{
+			return TriBool.False;
+		}
+		// The MSVC intrinsic also accepts one native indirection for an out parameter,
+		// but not void*, function pointers, or another level of native indirection.
+		if (type.InternalAs<CppPointerType>() is CppPointerType pointer)
+		{
+			type = pointer.InnerType;
+			if (type.IsPointer() || type.IsVoid() || type.IsFunctionType() ||
+			    type.IsRef || type.IsConst || type.IsVolatile)
+			{
+				return TriBool.False;
+			}
+		}
+		if (type.InternalAs<CppCliHandleType>() is CppCliHandleType handle)
+		{
+			type = handle.InnerType;
+			if (type.IsConst || type.IsVolatile || type.IsCliArray())
+			{
+				return TriBool.False;
+			}
+			return type.IsCliRefClassOrInterfaceType().ToTriBool();
+		}
+		if (type.IsVoid() || type.IsFunctionType() || type.IsNullptrType() || type.IsCliArray())
+		{
+			return TriBool.True;
+		}
+		if (type.GetNumericType() is CppNumericType numeric)
+		{
+			CppNumericTypeKind kind = numeric.Kind;
+			// WinRT metadata excludes Int8, C++ char/long, and extended floating types.
+			return (kind == CppIntTypeKind.BOOL || kind == CppIntTypeKind.UCHAR ||
+			        kind == CppIntTypeKind.WCHAR_T || kind == CppIntTypeKind.CHAR16_T || kind == CppIntTypeKind.CHAR32_T ||
+			        kind == CppIntTypeKind.SHORT || kind == CppIntTypeKind.USHORT ||
+			        kind == CppIntTypeKind.INT || kind == CppIntTypeKind.UINT ||
+			        kind == CppIntTypeKind.LONGLONG || kind == CppIntTypeKind.ULONGLONG ||
+			        kind == CppFloatTypeKind.FLOAT || kind == CppFloatTypeKind.DOUBLE).ToTriBool();
+		}
+		ICppClassResolveEntity clazz = type.InternalAs<ICppClassResolveEntity>();
+		return (clazz != null && (clazz.GetKey().IsCliClassOrInterface() || clazz.IsCliEnum())).ToTriBool();
+	}
+
+	// @MOD C++/CX
+	private TriBool IsWinRtAgile(CppQualType type, in CppViewPos vp)
+	{
+		if (type.GetDependentInfo().IsTypeOrValueDependentOrContainsDependencyKiller())
+		{
+			return TriBool.Indeterminate;
+		}
+		ICppClassResolveEntity clazz = type.InternalAs<ICppClassResolveEntity>();
+		if (clazz == null || !clazz.GetKey().IsCliRefClass() || clazz.IsCliDelegate())
+		{
+			return TriBool.False;
+		}
+		if (!clazz.IsClassComplete(in vp))
+		{
+			return TriBool.Indeterminate;
+		}
+		ICppClrElementResolveEntity clrElement = clazz.FindClrElement();
+		if (clrElement is ICppClrClassResolveEntity clrClass &&
+		    clrClass.GetBuiltinClass() is ICppClrClassResolveEntity.BuiltinClass.Object or ICppClrClassResolveEntity.BuiltinClass.String)
+		{
+			return TriBool.True;
+		}
+		if (clrElement?.ClrDeclaredElement is ITypeElement clrType)
+		{
+			foreach (IAttributeInstance attribute in clrType.GetAttributeInstances(AttributesSource.Self))
+			{
+				if (attribute.GetClrName().FullName != "Windows.Foundation.Metadata.MarshalingBehaviorAttribute")
+				{
+					continue;
+				}
+				if (attribute.PositionParameterCount != 1)
+				{
+					return TriBool.Indeterminate;
+				}
+				AttributeValue value = attribute.PositionParameter(0);
+				if (!value.IsConstant || !value.ConstantValue.IsValid())
+				{
+					return TriBool.Indeterminate;
+				}
+				ConstantValue constant = value.ConstantValue;
+				if (constant.IsEnum())
+				{
+					constant = constant.ToEnumUnderlyingType();
+				}
+				return constant.IsInteger(out int marshalingType) ? (marshalingType == 2).ToTriBool() : TriBool.Indeterminate;
+			}
+			// Imported classes without an agility contract are not known to be agile.
+			return TriBool.False;
+		}
+		foreach (ICppAttribute attribute in clazz.GetAttributes(in vp))
+		{
+			if (!attribute.GetName().Equals(CppAttribute.CxMarshalingBehaviorName))
+			{
+				continue;
+			}
+			if (attribute is not CppAttributeWithArgument<ICppExpression> { Argument: ICppResolvedExpression argument } ||
+			    argument.GetDependentInfo().IsTypeOrValueDependentOrContainsDependencyKiller())
+			{
+				return TriBool.Indeterminate;
+			}
+			return argument.EvaluateAndConvert(CppPredefinedTypes.Int, this) is CppIntegralValues.Int value
+				? (value.RawRepresentation == 2).ToTriBool()
+				: TriBool.Indeterminate;
+		}
+		// C++/CX ref classes are agile by default; Threading alone does not change marshaling.
+		return TriBool.True;
+	}
+
