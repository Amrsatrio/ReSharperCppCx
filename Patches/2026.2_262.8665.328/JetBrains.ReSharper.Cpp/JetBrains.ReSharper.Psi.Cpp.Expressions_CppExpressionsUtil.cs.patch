+	// @MOD Fix RSCPP-15665
+	internal static bool CheckQualifiedReferenceForMemberType(ICppResolvedExpression expression, out CppQualType memberT, in CppTypeContext tc)
+	{
+		if (expression is ICppParenExpression)
+		{
+			if (tc.Factory.GetDialect() is CppMSVCDialect and not CppClangOnWindowsToolset or CustomLanguageDialect { CompilerKind: Rider.Model.RadCompilerKind.MSVC })
+			{
+				while (expression is ICppParenExpression paren)
